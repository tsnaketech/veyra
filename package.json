{
  "name": "veyra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "pnpm -r test",
    "test:slow": "pnpm -r --if-present test:slow",
    "check": "pnpm -r check",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter studio dev",
    "qa:bench": "pnpm --filter @veyra/ai qa:bench",
    "motion:previews": "pnpm --filter @veyra/hyperframes-adapter motion:previews"
  }
}
