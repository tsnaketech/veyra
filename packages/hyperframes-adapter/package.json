{
  "name": "@veyra/hyperframes-adapter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "exports": "./src/index.ts",
  "scripts": {
    "test": "vitest run --exclude \"**/*.slow.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "lint": "prettier --check .",
    "test:slow": "vitest run src/render.slow.test.ts src/motion.slow.test.ts src/entry-state.slow.test.ts src/qa-checks.slow.test.ts",
    "motion:previews": "tsx src/previews-cli.ts"
  },
  "dependencies": {
    "@veyra/motion": "workspace:*",
    "@veyra/schemas": "workspace:*",
    "@veyra/storage": "workspace:*",
    "@veyra/video": "workspace:*",
    "gsap": "3.14.2",
    "hyperframes": "0.8.214",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3.8.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
